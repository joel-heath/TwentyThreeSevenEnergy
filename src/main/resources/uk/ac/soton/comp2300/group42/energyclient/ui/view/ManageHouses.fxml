<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import uk.ac.soton.comp2300.group42.energyclient.ui.view.components.BackOverlayPane?>
<?import uk.ac.soton.comp2300.group42.energyclient.ui.view.components.SettingsOverlayPane?>

<BackOverlayPane xmlns="http://javafx.com/javafx"
                 xmlns:fx="http://javafx.com/fxml"
                 fx:controller="uk.ac.soton.comp2300.group42.energyclient.ui.controller.ManageHousesController">

    <SettingsOverlayPane>
            <VBox alignment="CENTER" spacing="20">
                <Label text="Manage Houses" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
                <VBox spacing="5" alignment="CENTER">
                    <Label text="Active House"/>
                    <ComboBox fx:id="activeHouseComboBox" prefWidth="220"/>
                </VBox>

                <HBox alignment="CENTER" spacing="10">
                    <Button text="Edit House" onAction="#onEditHouse"/>
                    <Button text="Delete House" onAction="#onDeleteHouse" visible="false" managed="false"/>
                    <Button text="Leave House" onAction="#onLeaveHouse" visible="false" managed="false"/>
                </HBox>

                <ScrollPane>
                    <VBox fx:id="housematesContainer" spacing="10" alignment="TOP_CENTER" style="-fx-padding: 10;"/>
                </ScrollPane>

                <VBox spacing="5" alignment="CENTER">
                    <TextField fx:id="inviteHousemateField" promptText="Enter email to invite" prefWidth="220"/>
                    <Button text="Invite New Housemate" onAction="#onInviteHousemate"/>
                </VBox>

                <VBox spacing="5" alignment="CENTER">
                    <TextField fx:id="newHouseNameField" promptText="Enter new house name" prefWidth="220"/>
                    <TextField fx:id="newHouseAddressField" promptText="Enter new house address" prefWidth="220"/>
                    <Button text="Create New House" onAction="#onCreateNewHouse"/>
                </VBox>
            </VBox>
    </SettingsOverlayPane>
</BackOverlayPane>
