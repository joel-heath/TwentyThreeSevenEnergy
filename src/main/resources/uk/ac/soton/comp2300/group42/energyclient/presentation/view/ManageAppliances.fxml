<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import uk.ac.soton.comp2300.group42.energyclient.presentation.view.components.BackOverlayPane?>
<?import uk.ac.soton.comp2300.group42.energyclient.presentation.view.components.SettingsOverlayPane?>
<?import uk.ac.soton.comp2300.group42.energyclient.presentation.view.components.ModalOverlayPane?>

<?import uk.ac.soton.comp2300.group42.energyclient.presentation.view.components.Modal?>
<ModalOverlayPane xmlns="http://javafx.com/javafx"
                  xmlns:fx="http://javafx.com/fxml"
                  fx:controller="uk.ac.soton.comp2300.group42.energyclient.presentation.controller.ManageAppliancesController">

    <BackOverlayPane>
        <SettingsOverlayPane>
                <VBox alignment="CENTER" spacing="20">
                    <Label text="Manage Appliances" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
                    <Label fx:id="houseLabel" style="-fx-font-size: 18px;"/>

                    <ScrollPane>
                        <HBox fx:id="appliancesContainer" spacing="10" alignment="TOP_CENTER" style="-fx-padding: 10;"/>
                    </ScrollPane>

                    <VBox spacing="5" alignment="CENTER" maxWidth="220" fx:id="addContainer">
                        <TextField fx:id="addApplianceField" promptText="Enter appliance name"/>
                        <Button text="Add New Appliance" onAction="#onAddAppliance"/>
                    </VBox>
                </VBox>
        </SettingsOverlayPane>
    </BackOverlayPane>

    <Modal fx:id="editApplianceModal">
        <VBox maxWidth="250" maxHeight="300" styleClass="modal-card">
            <Label text="Edit Appliance" style="-fx-padding: 0 0 20 0;"/>
            <VBox style="-fx-padding: 5;">
                <Label text="Appliance Name"/>
                <TextField fx:id="editApplianceNameField" prefWidth="220"/>
            </VBox>
            <VBox alignment="CENTER" spacing="5" style="-fx-padding: 20 0 0 0;">
                <Button text="Save Edits" onAction="#onSaveApplianceEdits"/>
                <Button text="Delete Appliance" onAction="#onDeleteAppliance" fx:id="deleteApplianceButton"/>
                <Button text="Exit Without Saving" onAction="#onCloseEditModal"/>
            </VBox>
        </VBox>
    </Modal>
</ModalOverlayPane>
