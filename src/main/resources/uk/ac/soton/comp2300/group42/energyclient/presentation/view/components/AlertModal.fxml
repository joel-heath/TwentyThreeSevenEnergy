<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<fx:root type="uk.ac.soton.comp2300.group42.energyclient.presentation.view.components.AlertModal"
         xmlns="http://javafx.com/javafx"
         xmlns:fx="http://javafx.com/fxml">

    <VBox spacing="16" alignment="CENTER" maxWidth="280">
        <Label fx:id="titleLabel" text="Alert"/>
        <Label fx:id="messageLabel"
               text="This is an alert message."
               wrapText="true"
               maxWidth="240"/>

        <Button text="OK" onAction="#onOkClicked"/>
    </VBox>
</fx:root>
