<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import uk.ac.soton.comp2300.group42.energyclient.presentation.view.components.UpcomingActivationsWidget?>

<fx:root type="UpcomingActivationsWidget"
         xmlns:fx="http://javafx.com/fxml"
         spacing="10"
         prefWidth="280"
         styleClass="vbox upcoming-activations-widget">

    <ScrollPane vbarPolicy="NEVER" hbarPolicy="ALWAYS">
        <VBox style="-fx-padding: 10; -fx-spacing: 10;" >
            <Label text="Upcoming Device Schedules"/>
            <HBox fx:id="scheduleContainer" spacing="15"/>
        </VBox>
    </ScrollPane>

    <Button text="Schedule Appliance" onAction="#onSchedule"/>
</fx:root>
