<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import uk.ac.soton.comp2300.group42.energyclient.ui.view.components.BackOverlayPane?>
<?import uk.ac.soton.comp2300.group42.energyclient.ui.view.components.ToggleSwitch?>

<BackOverlayPane xmlns="http://javafx.com/javafx"
                 xmlns:fx="http://javafx.com/fxml"
                 fx:controller="uk.ac.soton.comp2300.group42.energyclient.ui.controller.SettingsController"
                 prefHeight="400.0" prefWidth="600.0">
    <VBox spacing="20" alignment="CENTER">

        <VBox spacing="5" alignment="CENTER">
            <Label text="Choose app appearance theme"/>
            <ComboBox fx:id="themeComboBox" prefWidth="220"/>
        </VBox>

        <VBox spacing="5" alignment="CENTER">
            <Label text="Choose app UI mode"/>
            <ComboBox fx:id="modeComboBox" prefWidth="220"/>
        </VBox>

        <VBox spacing="5" alignment="CENTER">
            <HBox spacing="10" alignment="CENTER">
                <Label text="Share Location"/>
                <ToggleSwitch fx:id="shareLocationToggle" onAction="#toggleShareLocation"/>
            </HBox>
        </VBox>

        <HBox spacing="10" alignment="CENTER">
            <TextField fx:id="costGoalField" promptText="Enter cost goal:"/>
            <Button text="Set Goal" onAction="#onSetCostGoal"/>
        </HBox>

        <Separator prefWidth="200" />
        <Button fx:id="accessibilityButton"
                text="Accessibility Settings"
                onAction="#onGoToAccessibility"
                prefWidth="220"/>

    </VBox>
</BackOverlayPane>