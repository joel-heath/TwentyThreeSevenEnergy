<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import uk.ac.soton.comp2300.group42.energyclient.view.components.ActivationSchedulePane?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="uk.ac.soton.comp2300.group42.energyclient.controller.ScheduleController"
           prefHeight="400.0" prefWidth="600.0">

    <Button text="Go back" onAction="#onBack" StackPane.alignment="TOP_LEFT">
        <StackPane.margin><Insets top="15" left="15"/></StackPane.margin>
    </Button>

    <VBox spacing="20" alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity">

        <Label text="Schedule Page"/>

        <ActivationSchedulePane fx:id="schedulePane"/>

        <Label fx:id="responseLabel" />
    </VBox>

</StackPane>