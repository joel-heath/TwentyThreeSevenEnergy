<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import uk.ac.soton.comp2300.group42.energyclient.ui.view.components.BackOverlayPane?>
<?import uk.ac.soton.comp2300.group42.energyclient.ui.view.components.SettingsOverlayPane?>
<?import uk.ac.soton.comp2300.group42.energyclient.ui.view.components.ModalOverlayPane?>

<?import uk.ac.soton.comp2300.group42.energyclient.ui.view.components.Modal?>
<ModalOverlayPane xmlns="http://javafx.com/javafx"
                  xmlns:fx="http://javafx.com/fxml"
                  fx:controller="uk.ac.soton.comp2300.group42.energyclient.ui.controller.ManageHousesController">

    <BackOverlayPane>
        <SettingsOverlayPane>
                <VBox alignment="CENTER" spacing="20">
                    <Label text="Manage Houses" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
                    <VBox spacing="5" alignment="CENTER">
                        <Label text="Active House"/>
                        <HBox alignment="CENTER">
                            <ComboBox fx:id="activeHouseComboBox" prefWidth="220"/>
                            <Button text="⚙" onAction="#onEditHouse"/>
                        </HBox>
                    </VBox>

                    <ScrollPane>
                        <VBox fx:id="housematesContainer" spacing="10" alignment="TOP_CENTER" style="-fx-padding: 10;"/>
                    </ScrollPane>

                    <VBox spacing="5" alignment="CENTER" maxWidth="220" fx:id="inviteContainer">
                        <TextField fx:id="inviteHousemateField" promptText="Enter email to invite"/>
                        <Button text="Invite New Housemate" onAction="#onInviteHousemate"/>
                    </VBox>

                    <VBox spacing="5" alignment="CENTER" maxWidth="220">
                        <TextField fx:id="newHouseNameField" promptText="Enter new house name"/>
                        <TextField fx:id="newHouseAddressField" promptText="Enter new house address"/>
                        <Button text="Create New House" onAction="#onCreateNewHouse"/>
                    </VBox>
                </VBox>
        </SettingsOverlayPane>
    </BackOverlayPane>

    <Modal fx:id="editHouseModal">
        <VBox maxWidth="250" maxHeight="300" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20;">
            <Label text="Edit House" style="-fx-padding: 0 0 20 0;"/>
            <VBox style="-fx-padding: 5;">
                <Label text="House Name"/>
                <TextField fx:id="editHouseNameField" prefWidth="220"/>
            </VBox>
            <VBox style="-fx-padding: 5;">
                <Label text="House Address"/>
                <TextField fx:id="editAddressField" prefWidth="220"/>
            </VBox>
            <VBox alignment="CENTER" spacing="5" style="-fx-padding: 20 0 0 0;">
                <Button text="Save Edits" onAction="#onSaveHouseEdits"/>
                <Button text="Leave House" onAction="#onLeaveHouse" fx:id="leaveHouseButton"/>
                <Button text="Delete House" onAction="#onDeleteHouse" fx:id="deleteHouseButton"/>
                <Button text="Exit Without Saving" onAction="#onCloseEditModal"/>
            </VBox>
            <Label fx:id="responseLabel"/>
        </VBox>
    </Modal>
</ModalOverlayPane>