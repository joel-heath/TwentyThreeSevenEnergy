<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import uk.ac.soton.comp2300.group42.energyclient.presentation.view.components.BackOverlayPane?>

<BackOverlayPane xmlns="http://javafx.com/javafx"
                 xmlns:fx="http://javafx.com/fxml"
                 fx:controller="uk.ac.soton.comp2300.group42.energyclient.presentation.controller.AccountSettingsController">

    <VBox spacing="20" alignment="CENTER">
        <VBox spacing="5" alignment="CENTER">
            <Label text="Name"/>
            <TextField fx:id="editNameField" promptText="Name" maxWidth="220"/>
        </VBox>
        <VBox spacing="5" alignment="CENTER">
            <Label text="Email"/>
            <TextField fx:id="editEmailField" promptText="Email" maxWidth="220"/>
        </VBox>
        <VBox spacing="5" alignment="CENTER">
            <Label text="Change Password"/>
            <PasswordField fx:id="passwordField" promptText="New Password" maxWidth="220"/>
            <PasswordField fx:id="confirmPasswordField" promptText="Confirm Password" maxWidth="220"/>
        </VBox>

        <Button onAction="#onUpdateAccount" text="Update Account"/>

        <Button fx:id="logoutButton" onAction="#onLogout" text="Logout"/>

        <Label fx:id="responseLabel"/>
    </VBox>
</BackOverlayPane>