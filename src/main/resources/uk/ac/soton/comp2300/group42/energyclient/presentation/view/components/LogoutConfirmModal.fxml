<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<fx:root type="uk.ac.soton.comp2300.group42.energyclient.presentation.view.components.LogoutConfirmModal"
         xmlns="http://javafx.com/javafx"
         xmlns:fx="http://javafx.com/fxml">

    <VBox spacing="16" alignment="CENTER" maxWidth="280" styleClass="modal-content">
        <Label fx:id="titleLabel" text="Sign out?" styleClass="modal-title"/>
        <Label fx:id="messageLabel"
               text="You will need to log in again to access your account."
               wrapText="true"
               maxWidth="240"
               styleClass="modal-message"/>

        <HBox spacing="12" alignment="CENTER">
            <Button text="Cancel" onAction="#onCancelClicked"/>
            <Button text="Confirm" onAction="#onConfirmClicked"/>
        </HBox>
    </VBox>
</fx:root>