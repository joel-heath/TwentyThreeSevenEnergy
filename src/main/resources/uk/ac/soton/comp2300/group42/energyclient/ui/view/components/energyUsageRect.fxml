<?xml version="1.0" encoding="UTF-8"?>


<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.paint.Stop?>
<?import javafx.scene.paint.LinearGradient?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="uk.ac.soton.comp2300.group42.energyclient.ui.view.components.EnergyUsageRect"
           alignment="CENTER">

    <!-- Background bar -->
    <Rectangle width="250" height="25"
               arcWidth="10" arcHeight="10"
               fill="#cccccc"/>

    <!-- Progress bar -->
    <Rectangle fx:id="usageRect"
               width="250" height="25"
               arcWidth="10" arcHeight="10">
        <fill>
            <LinearGradient endY="0">
                <stops>
                    <Stop color="#2ECC71"/>  <!-- green -->
                    <Stop offset="0.5" color="#FFC107"/>  <!-- yellow -->
                    <Stop offset="1.0" color="#E74C3C"/>  <!-- red -->
                </stops>
            </LinearGradient>
        </fill>
    </Rectangle>

</StackPane>
